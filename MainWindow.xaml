<Window x:Class="chatbot_ai.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="580" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cybersecurity Awareness Bot" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <Image Grid.Row="1" x:Name="LogoImage" Source="logoimage.jpeg" 
               Width="80" Height="80" HorizontalAlignment="Center" Margin="0,5,0,0"
               ImageFailed="LogoImage_ImageFailed"
               ToolTip="Cybersecurity Bot Logo" VerticalAlignment="Top"/>

        <ListBox Grid.Row="2" x:Name="ChatHistory" Margin="0,5,0,5"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White" BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                               TextWrapping="Wrap" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Margin="0,0,5,0"
                     Height="30" VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="60"
                    Height="30" Click="SendButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button x:Name="TaskButton" Content="Task Manager" Width="100" Height="35" 
                    Click="TaskButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="QuizButton" Content="Start Quiz" Width="100" Height="35" 
                    Click="QuizButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="ExitButton" Content="Exit" Width="60" Height="35" 
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>